#!/bin/zsh
set -eu
SCRIPT_DIR="${0:A:h}"
AUTOASSIST_ROOT="${SCRIPT_DIR:h:h}"
ACCOUNT_HOME="${AUTOASSIST_ACCOUNT_HOME:-${HOME}}"

fail() { /bin/echo "Autobot: $1" >&2; exit 1; }
usage() {
  /bin/cat <<'HELP'
Usage: autoassist <command> [arguments]
  doctor [--quiet|--json]                  Read-only installation and readiness check.
  initialize-zones                        Create empty owner-only privacy zones.
  version                                 Print installed version.
  core <action>                           Node 22+ JSON API; request on stdin.
  core help                               List actions and limits.
  objective-create <id> <title>            Legacy CLI, imported into the single core store.
  checkpoint <id> <stage> <file> <actor>   Report legacy stage evidence inside this install.
  validate-stage <id> <stage> <validator>  Validate legacy evidence; labels are not identities.
  objective-status [id]                    Read-only task status.
  supervisor-tick                          Code-only liveness and recovery marker.
  privacy-scan <clean-root> [--media-review FILE]  Scan only an explicit clean release.
HELP
}
# This file is the installation-bound entry point; environment paths never redirect it.
node_path() {
  local candidate="" version=""
  if [[ "${AUTOASSIST_NODE+x}" == x ]]; then
    candidate="$AUTOASSIST_NODE"
  elif [[ -f "$AUTOASSIST_ROOT/.install-state/receipt.json" && ! -L "$AUTOASSIST_ROOT/.install-state/receipt.json" ]]; then
    candidate="$(/usr/bin/plutil -extract node_path raw -o - "$AUTOASSIST_ROOT/.install-state/receipt.json" 2>/dev/null || true)"
    [[ "$candidate" == null ]] && candidate=""
  fi
  if [[ -z "$candidate" && "${AUTOASSIST_NODE+x}" != x ]]; then candidate="$(command -v node || true)"; fi
  [[ "$candidate" == /* && -f "$candidate" && -x "$candidate" ]] || return 1
  version="$("$candidate" -p 'Number(process.versions.node.split(".")[0])' 2>/dev/null)" || return 1
  [[ "$version" == <-> && "$version" -ge 22 ]] || return 1
  /bin/echo "$candidate"
}
run_core() { local node; node="$(node_path)" || fail "runtime-unavailable: advanced commands require Node 22 or newer; no state was changed."; exec "$node" "$AUTOASSIST_ROOT/runtime/core/cli.mjs" "$@"; }
check_path() {
  local p="$1" current="/" part
  for part in ${(s:/:)p}; do
    [[ -z "$part" ]] && continue
    current="${current%/}/$part"
    [[ ! -L "$current" ]] || fail "symlink path rejected"
    if [[ -e "$current" && "$current" != "$p" ]]; then [[ -d "$current" ]] || fail "unsafe path ancestor"; fi
  done
}
initialize_zones() {
  [[ ! -e "$AUTOASSIST_ROOT/.install-state/migration.lock" ]] || fail "installation-migrating"
  check_path "$AUTOASSIST_ROOT/00_CONTEXT"
  /bin/mkdir -p "$AUTOASSIST_ROOT/00_CONTEXT"
  /bin/chmod 700 "$AUTOASSIST_ROOT/00_CONTEXT"
  local zone dest
  for zone in PRIVATE FAMILY_FRIENDS WORK SHARED; do
    dest="$AUTOASSIST_ROOT/00_CONTEXT/$zone";check_path "$dest";check_path "$dest/INDEX.md"
    /bin/mkdir -p "$dest";/bin/chmod 700 "$dest"
    if [[ ! -e "$dest/INDEX.md" ]]; then /usr/bin/printf '# %s index\n\nNo records yet.\n' "$zone" > "$dest/INDEX.md";/bin/chmod 600 "$dest/INDEX.md";fi
  done
  /bin/echo "Privacy zones initialized."
}
base_doctor() {
  if [[ -x "$AUTOASSIST_ROOT/runtime/lib/install-doctor.sh" ]]; then exec "$AUTOASSIST_ROOT/runtime/lib/install-doctor.sh" "$AUTOASSIST_ROOT" "$ACCOUNT_HOME" "$@";fi
  [[ -f "$AUTOASSIST_ROOT/VERSION" && -f "$AUTOASSIST_ROOT/AGENTS.md" ]] || fail "installation-integrity-failed"
  local availability="runtime-unavailable";node_path >/dev/null 2>&1 && availability="available"
  if [[ "${1:-}" == --json ]]; then /usr/bin/printf '{"installation_integrity":"unverified-source-tree","runtime_status":"%s"}\n' "$availability"
  elif [[ "${1:-}" != --quiet ]]; then /bin/echo "Source tree present. Installed receipt integrity is unverified. Advanced runtime: $availability.";fi
}
command="${1:-help}";[[ $# -eq 0 ]] || shift
case "$command" in
  help|-h|--help) [[ $# -eq 0 ]] || fail "help takes no arguments";usage ;;
  version) [[ $# -eq 0 ]] || fail "version takes no arguments";/bin/cat "$AUTOASSIST_ROOT/VERSION" ;;
  doctor) [[ $# -le 1 && ( $# -eq 0 || "$1" == --quiet || "$1" == --json ) ]] || fail "doctor accepts --quiet or --json";base_doctor "$@" ;;
  initialize-zones) [[ $# -eq 0 ]] || fail "initialize-zones takes no arguments";initialize_zones ;;
  core) [[ $# -eq 1 ]] || fail "core requires one action and JSON on stdin";run_core "$1" ;;
  objective-create) [[ $# -eq 2 ]] || fail "objective-create requires id title";run_core legacy "$command" "$@" ;;
  checkpoint) [[ $# -eq 4 ]] || fail "checkpoint requires id stage file actor";run_core legacy "$command" "$@" ;;
  validate-stage) [[ $# -eq 3 ]] || fail "validate-stage requires id stage validator";run_core legacy "$command" "$@" ;;
  objective-status) [[ $# -le 1 ]] || fail "objective-status accepts at most one id";run_core legacy "$command" "$@" ;;
  supervisor-tick) [[ $# -eq 0 ]] || fail "supervisor-tick takes no arguments";run_core legacy "$command" ;;
  privacy-scan) [[ $# -eq 1 || ( $# -eq 3 && "$2" == --media-review ) ]] || fail "privacy-scan requires an explicit clean release root, optionally --media-review FILE"; clean_root="$1";shift;[[ "$clean_root" == /* && ! -e "$clean_root/.install-state/managed-by-autoassist" && ! -e "$clean_root/.install-state/receipt.json" ]] || fail "release scan refuses a configured installation"; scanner_node="$(node_path)" || fail "runtime-unavailable: publication scan requires Node 22 or newer";exec "$scanner_node" "$AUTOASSIST_ROOT/scripts/publication-scan.mjs" --root "$clean_root" "$@" ;;
  *) fail "unknown command; use help" ;;
esac
